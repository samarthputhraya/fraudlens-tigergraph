USE GRAPH Fraud

CREATE LOADING JOB load_customers FOR GRAPH Fraud {
  DEFINE FILENAME f;
  LOAD f TO VERTEX Customer VALUES ($"customer_id") USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_cards FOR GRAPH Fraud {
  DEFINE FILENAME f;
  LOAD f TO VERTEX Card VALUES ($"card_id", $"customer_id", $"network", $"card_type", $"issuer",
                                $"n_txn", $"first_ts", $"last_ts", _, _)
       USING header="true", separator=",", QUOTE="double";
  LOAD f TO EDGE OWNS VALUES ($"customer_id", $"card_id") USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_transactions FOR GRAPH Fraud {
  DEFINE FILENAME f;
  LOAD f TO VERTEX Transaction VALUES ($"id", $"card_id", $"customer_id", $"ts", $"dt", $"amt", $"product",
        $"channel", $"risk_score", $"addr1", $"addr2", $"dist1", $"dist2", $"p_email", $"r_email",
        $"m123", $"m4", $"m5", $"m6", $"m789",
        $"c1", $"c2", $"c5", $"c6", $"c9", $"c11", $"c13", $"c14",
        $"d1", $"d2", $"d3", $"d4", $"d10", $"d15",
        $"v258", $"v257", $"v294", $"v283", $"v317", $"v307", $"v127", $"v133", $"v70", $"v91", _)
       USING header="true", separator=",", QUOTE="double";
  LOAD f TO EDGE MADE VALUES ($"card_id", $"id") USING header="true", separator=",", QUOTE="double";
  LOAD f TO EDGE BILLED_IN VALUES ($"id", $"addr1") WHERE $"addr1" != "" USING header="true", separator=",", QUOTE="double";
  LOAD f TO EDGE PURCHASER_EMAIL VALUES ($"id", $"p_email") WHERE $"p_email" != "" USING header="true", separator=",", QUOTE="double";
  LOAD f TO EDGE RECIPIENT_EMAIL VALUES ($"id", $"r_email") WHERE $"r_email" != "" USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_accounts FOR GRAPH Fraud {
  DEFINE FILENAME f;
  LOAD f TO VERTEX Account VALUES ($"id", $"card_id", $"addr1", $"open_day", $"n_txn", $"first_ts", $"last_ts")
       USING header="true", separator=",", QUOTE="double";
  LOAD f TO EDGE HAS_ACCOUNT VALUES ($"card_id", $"id") USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_account_edges FOR GRAPH Fraud {
  DEFINE FILENAME f;
  LOAD f TO EDGE ON_ACCOUNT VALUES ($"txn_id", $"account_id") USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_next FOR GRAPH Fraud {
  DEFINE FILENAME f;
  LOAD f TO EDGE NEXT VALUES ($"src", $"dst", $"gap_s") USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_devices FOR GRAPH Fraud {
  DEFINE FILENAME f;
  LOAD f TO VERTEX DeviceProfile VALUES ($"id", $"device_info", $"os", $"browser", $"screen", $"device_type",
        $"n_txn", $"generic") USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_device_edges FOR GRAPH Fraud {
  DEFINE FILENAME f;
  LOAD f TO EDGE FROM_DEVICE VALUES ($"txn_id", $"device_id", $"is_new", $"proxy", $"id_34", $"device_type",
        $"id_01", $"id_02", $"id_05", $"id_06", $"id_11") USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_card_device FOR GRAPH Fraud {
  DEFINE FILENAME f;
  LOAD f TO EDGE CARD_DEVICE VALUES ($"card_id", $"device_id", $"n", $"n_new", $"first_ts", $"last_ts")
       USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_card_region FOR GRAPH Fraud {
  DEFINE FILENAME f;
  LOAD f TO EDGE CARD_REGION VALUES ($"card_id", $"region_id", $"n", $"first_ts", $"last_ts")
       USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_closed_cases FOR GRAPH Fraud {
  DEFINE FILENAME f;
  LOAD f TO VERTEX ClosedCase VALUES ($"case_id", $"customer_id", $"card_id", $"opened_at", $"closed_at",
        $"outcome", $"pattern", $"first_fraud_txn_id", $"n_txns", $"exposure_usd", $"actions_taken",
        $"report_filed", $"analyst_notes") USING header="true", separator=",", QUOTE="double";
  LOAD f TO EDGE ON_CARD VALUES ($"case_id", $"card_id") USING header="true", separator=",", QUOTE="double";
  LOAD f TO EDGE CC_PATTERN VALUES ($"case_id", $"pattern") USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_closed_involves FOR GRAPH Fraud {
  DEFINE FILENAME f;
  LOAD f TO EDGE INVOLVES VALUES ($"case_id", $"txn_id") USING header="true", separator=",", QUOTE="double";
}

CREATE LOADING JOB load_closed_connected FOR GRAPH Fraud {
  DEFINE FILENAME f;
  LOAD f TO EDGE CONNECTED_TO VALUES ($"case_id", $"card_id") USING header="true", separator=",", QUOTE="double";
}
