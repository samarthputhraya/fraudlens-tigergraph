CREATE OR REPLACE QUERY account_history(VERTEX<Transaction> txn, INT lookback_days = 200) FOR GRAPH Fraud {
  /* Resolved-account memory (entity resolution): every earlier transaction on the same cardholder account as the
     flagged transaction (card + billing region + account-open day), and the closed / investigation cases those
     transactions belong to. Prior confirmed fraud on the same account is the strongest single fraud signal. */
  SetAccum<STRING> @closed_cases, @outcomes, @patterns, @inv_cases;
  SumAccum<STRING> @device, @is_new;
  MaxAccum<DATETIME> @@t0;
  DATETIME since;
  T0 = {txn};
  S = SELECT t FROM T0:t ACCUM @@t0 += t.ts;
  since = datetime_sub(@@t0, INTERVAL lookback_days DAY);
  A = SELECT a FROM T0:t -(ON_ACCOUNT:e)-> Account:a;
  H = SELECT t FROM A:a -(rev_ON_ACCOUNT:e)-> Transaction:t WHERE t.ts < @@t0 AND t.ts >= since;
  X = SELECT t FROM H:t -(rev_INVOLVES:e)-> ClosedCase:cc
      ACCUM t.@closed_cases += cc.id, t.@outcomes += cc.outcome, t.@patterns += cc.pattern;
  Y = SELECT t FROM H:t -(rev_CASE_TXN:e)-> InvestigationCase:ic ACCUM t.@inv_cases += ic.case_ref;
  Z = SELECT t FROM H:t -(FROM_DEVICE:e)-> DeviceProfile:d ACCUM t.@device = d.id, t.@is_new = e.is_new;
  PRINT A[A.id, A.card_id, A.addr1, A.open_day, A.n_txn, A.first_ts, A.last_ts] AS account;
  PRINT H[H.id, H.ts, H.amt, H.product, H.channel, H.addr1, H.risk_score, H.@device, H.@is_new,
          H.@closed_cases, H.@outcomes, H.@patterns, H.@inv_cases] AS history;
}
