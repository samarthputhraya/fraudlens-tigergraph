CREATE OR REPLACE QUERY card_testing_scan(DATETIME start_ts, DATETIME end_ts, DOUBLE small = 5.0, INT min_n = 3) FOR GRAPH Fraud {
  /* Cards with several tiny online authorisations (default under $5) inside the window: candidates for card
     testing (pattern 1, policy R5). Python checks the one-hour sequence and the larger follow-up purchase. */
  ListAccum<STRING> @txns;
  SumAccum<INT> @n;
  All = {Transaction.*};
  T = SELECT t FROM All:t
      WHERE t.ts >= start_ts AND t.ts <= end_ts AND t.channel == "online" AND t.amt < small;
  C = SELECT c FROM T:t -(rev_MADE:e)-> Card:c
      ACCUM c.@n += 1, c.@txns += (t.id + "|" + datetime_format(t.ts, "%Y-%m-%d %H:%M:%S") + "|" + to_string(t.amt));
  C = SELECT c FROM C:c WHERE c.@n >= min_n;
  PRINT C[C.id, C.customer_id, C.@n, C.@txns] AS cards;
}
