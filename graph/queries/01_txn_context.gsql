CREATE OR REPLACE QUERY txn_context(VERTEX<Transaction> txn) FOR GRAPH Fraud {
  /* Flagged transaction with its card, customer, device/identity signals and emails. */
  SumAccum<STRING> @device, @is_new, @proxy, @id_34, @device_type;
  SumAccum<INT> @device_txns;
  OrAccum @device_generic;
  T = {txn};
  D = SELECT t FROM T:t -(FROM_DEVICE:e)-> DeviceProfile:d
      ACCUM t.@device = d.id, t.@is_new = e.is_new, t.@proxy = e.proxy, t.@id_34 = e.id_34,
            t.@device_type = e.device_type, t.@device_txns += d.n_txn, t.@device_generic += d.is_generic;
  C = SELECT c FROM T:t -(rev_MADE:e)-> Card:c;
  PRINT T[T.id, T.card_id, T.customer_id, T.ts, T.amt, T.product, T.channel, T.risk_score, T.addr1, T.addr2,
          T.dist1, T.p_email, T.r_email, T.m123, T.m4, T.m5, T.m6, T.m789, T.c1, T.c13, T.c14, T.d1, T.d15,
          T.@device, T.@is_new, T.@proxy, T.@id_34, T.@device_type, T.@device_txns, T.@device_generic] AS txn;
  PRINT C[C.id, C.customer_id, C.network, C.card_type, C.n_txn, C.first_ts, C.last_ts] AS card;
}
