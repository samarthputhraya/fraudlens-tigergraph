CREATE OR REPLACE QUERY structuring_scan(DATETIME start_ts, DATETIME end_ts, DOUBLE lo = 400.0, DOUBLE hi = 500.0, INT min_n = 3) FOR GRAPH Fraud {
  /* Cards with several online purchases just under an authorisation threshold (default $400-$500) inside the
     window: candidates for sub-threshold structuring (undocumented pattern). Python checks the time clustering. */
  ListAccum<STRING> @txns;
  SumAccum<INT> @n;
  All = {Transaction.*};
  T = SELECT t FROM All:t
      WHERE t.ts >= start_ts AND t.ts <= end_ts AND t.channel == "online" AND t.amt >= lo AND t.amt < hi;
  C = SELECT c FROM T:t -(rev_MADE:e)-> Card:c
      ACCUM c.@n += 1, c.@txns += (t.id + "|" + datetime_format(t.ts, "%Y-%m-%d %H:%M:%S") + "|" + to_string(t.amt));
  C = SELECT c FROM C:c WHERE c.@n >= min_n;
  PRINT C[C.id, C.customer_id, C.@n, C.@txns] AS cards;
}
