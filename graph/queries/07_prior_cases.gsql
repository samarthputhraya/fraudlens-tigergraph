CREATE OR REPLACE QUERY prior_cases(VERTEX<Card> card) FOR GRAPH Fraud {
  /* Case memory reachable from a card: closed cases on this card or the customer's other cards, closed cases
     that list this card as connected, and earlier investigation cases touching these cards. */
  Start = {card};
  Cust = SELECT cu FROM Start:c -(rev_OWNS:e)-> Customer:cu;
  Cards = SELECT c FROM Cust:cu -(OWNS:e)-> Card:c;
  CC = SELECT cc FROM Cards:c -(rev_ON_CARD:e)-> ClosedCase:cc;
  CX = SELECT cc FROM Start:c -(rev_CONNECTED_TO:e)-> ClosedCase:cc;
  IC = SELECT ic FROM Cards:c -(rev_CASE_CARD:e)-> InvestigationCase:ic;
  PRINT Cards[Cards.id, Cards.network, Cards.card_type, Cards.n_txn, Cards.first_ts, Cards.last_ts] AS customer_cards;
  PRINT CC[CC.id, CC.card_id, CC.opened_at, CC.outcome, CC.pattern, CC.exposure_usd, CC.n_txns,
           CC.actions_taken, CC.report_filed, CC.analyst_notes] AS closed_cases;
  PRINT CX[CX.id, CX.card_id, CX.opened_at, CX.outcome, CX.pattern, CX.analyst_notes] AS connected_cases;
  PRINT IC[IC.id, IC.case_ref, IC.opened_at, IC.status, IC.verdict, IC.pattern, IC.summary] AS investigations;
}
