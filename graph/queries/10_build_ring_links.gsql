CREATE OR REPLACE QUERY build_ring_links(DATETIME start_ts, DATETIME end_ts, INT max_cards = 60, INT min_cards = 3) FOR GRAPH Fraud {
  /* Projects device profiles used as a NEW device behind an anonymising proxy by several cards inside the window into
     Card-RING_LINK-Card edges (one clique per device). The projection is the input to GDBMS_ALGO.community.wcc. */
  SetAccum<VERTEX<Card>> @card;
  SetAccum<VERTEX<Card>> @new_cards;
  SumAccum<INT> @@devices, @@links;
  Devs = {DeviceProfile.*};
  Devs = SELECT d FROM Devs:d WHERE d.is_generic == FALSE;
  T = SELECT t FROM Devs:d -(rev_FROM_DEVICE:e)-> Transaction:t
      WHERE t.ts >= start_ts AND t.ts <= end_ts AND e.dev_new == "New"
        AND (e.proxy_type == "IP_PROXY:ANONYMOUS" OR e.proxy_type == "IP_PROXY:HIDDEN");
  C = SELECT t FROM T:t -(rev_MADE:m)-> Card:c ACCUM t.@card += c;
  X = SELECT d FROM T:t -(FROM_DEVICE:e)-> DeviceProfile:d ACCUM d.@new_cards += t.@card;
  Hubs = SELECT d FROM X:d WHERE d.@new_cards.size() >= min_cards AND d.@new_cards.size() <= max_cards
         ACCUM @@devices += 1,
           FOREACH c1 IN d.@new_cards DO
             FOREACH c2 IN d.@new_cards DO
               IF getvid(c1) < getvid(c2) THEN
                 INSERT INTO RING_LINK VALUES (c1, c2, 1.0, d.id, start_ts, end_ts), @@links += 1
               END
             END
           END;
  PRINT @@devices AS ring_devices, @@links AS links_inserted;
  PRINT Hubs[Hubs.id, Hubs.@new_cards.size()] AS ring_hubs;
}
