USE GRAPH Fraud
CREATE SCHEMA_CHANGE JOB add_vectors FOR GRAPH Fraud {
  ALTER VERTEX ClosedCase ADD VECTOR ATTRIBUTE emb (DIMENSION=768, METRIC="COSINE");
  ALTER VERTEX InvestigationCase ADD VECTOR ATTRIBUTE emb (DIMENSION=768, METRIC="COSINE");
  ALTER VERTEX DocChunk ADD VECTOR ATTRIBUTE emb (DIMENSION=768, METRIC="COSINE");
}
RUN SCHEMA_CHANGE JOB add_vectors
DROP JOB add_vectors
