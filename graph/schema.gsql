CREATE GRAPH Fraud ()
USE GRAPH Fraud
CREATE SCHEMA_CHANGE JOB build_fraud_schema FOR GRAPH Fraud {
  // ---- Core payment graph (from the dataset) -------------------------------------------
  ADD VERTEX Customer (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX Card (PRIMARY_ID id STRING, customer_id STRING, network STRING, card_type STRING,
                   issuer STRING, n_txn INT, first_ts DATETIME, last_ts DATETIME,
                   wcc_id INT DEFAULT -1, louvain_id INT DEFAULT -1) WITH primary_id_as_attribute="true";
  ADD VERTEX Transaction (PRIMARY_ID id STRING, card_id STRING, customer_id STRING, ts DATETIME, dt INT,
                   amt DOUBLE, product STRING, channel STRING, risk_score DOUBLE,
                   addr1 STRING, addr2 STRING, dist1 DOUBLE, dist2 DOUBLE, p_email STRING, r_email STRING,
                   m123 STRING, m4 STRING, m5 STRING, m6 STRING, m789 STRING,
                   c1 DOUBLE, c2 DOUBLE, c5 DOUBLE, c6 DOUBLE, c9 DOUBLE, c11 DOUBLE, c13 DOUBLE, c14 DOUBLE,
                   d1 DOUBLE, d2 DOUBLE, d3 DOUBLE, d4 DOUBLE, d10 DOUBLE, d15 DOUBLE,
                   v258 DOUBLE, v257 DOUBLE, v294 DOUBLE, v283 DOUBLE, v317 DOUBLE, v307 DOUBLE,
                   v127 DOUBLE, v133 DOUBLE, v70 DOUBLE, v91 DOUBLE) WITH primary_id_as_attribute="true";
  // Resolved cardholder account behind an anonymised card: card + billing region + account-open day (from D1).
  ADD VERTEX Account (PRIMARY_ID id STRING, card_id STRING, addr1 STRING, open_day INT, n_txn INT,
                   first_ts DATETIME, last_ts DATETIME) WITH primary_id_as_attribute="true";
  ADD VERTEX DeviceProfile (PRIMARY_ID id STRING, device_info STRING, os STRING, browser STRING,
                   screen STRING, device_type STRING, n_txn INT, is_generic BOOL) WITH primary_id_as_attribute="true";
  ADD VERTEX EmailDomain (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX BillingRegion (PRIMARY_ID id STRING) WITH primary_id_as_attribute="true";

  // ---- Bank knowledge: closed cases, policy, typologies, documents ----------------------
  ADD VERTEX ClosedCase (PRIMARY_ID id STRING, customer_id STRING, card_id STRING, opened_at DATETIME,
                   closed_at DATETIME, outcome STRING, pattern STRING, first_fraud_txn_id STRING,
                   n_txns INT, exposure_usd DOUBLE, actions_taken STRING, report_filed BOOL,
                   analyst_notes STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX PolicyRule (PRIMARY_ID id STRING, title STRING, body STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX FraudPattern (PRIMARY_ID id STRING, name STRING, description STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX DocChunk (PRIMARY_ID id STRING, source STRING, section STRING, body STRING) WITH primary_id_as_attribute="true";

  // ---- Agent case memory ---------------------------------------------------------------
  ADD VERTEX InvestigationCase (PRIMARY_ID id STRING, case_ref STRING, trigger_type STRING, opened_at DATETIME,
                   updated_at DATETIME, status STRING, verdict STRING, fraud_probability DOUBLE,
                   pattern STRING, pattern_description STRING, exposure_usd DOUBLE, summary STRING,
                   sar_filed BOOL, initial_actions STRING, final_actions STRING, what_changed STRING,
                   stop_reason STRING, answer_json STRING) WITH primary_id_as_attribute="true";
  ADD VERTEX EvidenceRequest (PRIMARY_ID id STRING, req_type STRING, asked_after_step INT,
                   assumed_response STRING, created_at DATETIME) WITH primary_id_as_attribute="true";
  ADD VERTEX ActionRecord (PRIMARY_ID id STRING, action STRING, route STRING, reason STRING, stage STRING,
                   status STRING, approver_role STRING, decided_at DATETIME) WITH primary_id_as_attribute="true";

  // ---- Edges ---------------------------------------------------------------------------
  ADD DIRECTED EDGE OWNS (FROM Customer, TO Card) WITH REVERSE_EDGE="rev_OWNS";
  ADD DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="rev_MADE";
  ADD DIRECTED EDGE HAS_ACCOUNT (FROM Card, TO Account) WITH REVERSE_EDGE="rev_HAS_ACCOUNT";
  ADD DIRECTED EDGE ON_ACCOUNT (FROM Transaction, TO Account) WITH REVERSE_EDGE="rev_ON_ACCOUNT";
  ADD DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile, dev_new STRING, proxy_type STRING,
                   id_34 STRING, device_type STRING, id_01 DOUBLE, id_02 DOUBLE, id_05 DOUBLE,
                   id_06 DOUBLE, id_11 DOUBLE) WITH REVERSE_EDGE="rev_FROM_DEVICE";
  ADD DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="rev_PURCHASER_EMAIL";
  ADD DIRECTED EDGE RECIPIENT_EMAIL (FROM Transaction, TO EmailDomain) WITH REVERSE_EDGE="rev_RECIPIENT_EMAIL";
  ADD DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion) WITH REVERSE_EDGE="rev_BILLED_IN";
  ADD DIRECTED EDGE NEXT (FROM Transaction, TO Transaction, gap_s INT) WITH REVERSE_EDGE="PREV";
  ADD UNDIRECTED EDGE CARD_DEVICE (FROM Card, TO DeviceProfile, n INT, n_new INT, first_ts DATETIME, last_ts DATETIME);
  ADD UNDIRECTED EDGE CARD_REGION (FROM Card, TO BillingRegion, n INT, first_ts DATETIME, last_ts DATETIME);
  // Card-Card projection built per time window from rare shared devices; input to GDBMS_ALGO WCC/Louvain.
  ADD UNDIRECTED EDGE RING_LINK (FROM Card, TO Card, weight DOUBLE, via STRING, first_ts DATETIME, last_ts DATETIME);

  ADD DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction) WITH REVERSE_EDGE="rev_INVOLVES";
  ADD DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="rev_ON_CARD";
  ADD DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card) WITH REVERSE_EDGE="rev_CONNECTED_TO";
  ADD DIRECTED EDGE CC_PATTERN (FROM ClosedCase, TO FraudPattern) WITH REVERSE_EDGE="rev_CC_PATTERN";
  ADD DIRECTED EDGE DOC_RULE (FROM DocChunk, TO PolicyRule) WITH REVERSE_EDGE="rev_DOC_RULE";
  ADD DIRECTED EDGE DOC_PATTERN (FROM DocChunk, TO FraudPattern) WITH REVERSE_EDGE="rev_DOC_PATTERN";

  ADD DIRECTED EDGE CASE_TXN (FROM InvestigationCase, TO Transaction, role STRING) WITH REVERSE_EDGE="rev_CASE_TXN";
  ADD DIRECTED EDGE CASE_CARD (FROM InvestigationCase, TO Card, role STRING) WITH REVERSE_EDGE="rev_CASE_CARD";
  ADD DIRECTED EDGE CASE_DEVICE (FROM InvestigationCase, TO DeviceProfile) WITH REVERSE_EDGE="rev_CASE_DEVICE";
  ADD DIRECTED EDGE CASE_CITES (FROM InvestigationCase, TO ClosedCase, score DOUBLE, reason STRING) WITH REVERSE_EDGE="rev_CASE_CITES";
  ADD DIRECTED EDGE CASE_CITES_INV (FROM InvestigationCase, TO InvestigationCase, score DOUBLE, reason STRING) WITH REVERSE_EDGE="rev_CASE_CITES_INV";
  ADD DIRECTED EDGE CASE_RULE (FROM InvestigationCase, TO PolicyRule) WITH REVERSE_EDGE="rev_CASE_RULE";
  ADD DIRECTED EDGE CASE_PATTERN (FROM InvestigationCase, TO FraudPattern) WITH REVERSE_EDGE="rev_CASE_PATTERN";
  ADD DIRECTED EDGE CASE_REQUEST (FROM InvestigationCase, TO EvidenceRequest) WITH REVERSE_EDGE="rev_CASE_REQUEST";
  ADD DIRECTED EDGE CASE_ACTION (FROM InvestigationCase, TO ActionRecord) WITH REVERSE_EDGE="rev_CASE_ACTION";
}
RUN SCHEMA_CHANGE JOB build_fraud_schema
DROP JOB build_fraud_schema
