# TigerGraph Savanna (Database Secret from Savanna > Database Secrets)
TG_HOST=https://<workspace-id>.i.tgcloud.io
TG_GRAPHNAME=Fraud
TG_SECRET=<database-secret>

# Google Vertex AI (Gemini) - uses Application Default Credentials (gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT=<gcp-project-id>
GOOGLE_CLOUD_LOCATION=global
LLM_MODEL_PRO=gemini-3.1-pro-preview
LLM_MODEL_FLASH=gemini-3.5-flash
EMBED_MODEL=text-embedding-005
